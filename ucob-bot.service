# Install: copy to /etc/systemd/system/ucob-bot.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ucob-bot
# Logs: journalctl -u ucob-bot -f
# Adjust User and the paths below to match your VPS.

[Unit]
Description=UCoB Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ucob
WorkingDirectory=/opt/ucob-bot
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/ucob-bot

[Install]
WantedBy=multi-user.target
